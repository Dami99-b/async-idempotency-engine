apiVersion: v1
kind: ConfigMap
metadata:
  name: api-config
  namespace: {{ namespace }}
data:
  REDIS_HOST: redis
  REDIS_PORT: "6379"
  IDEMPOTENCY_TTL: "{{ idempotency_ttl }}"
  IDEMPOTENCY_LOCK_TTL: "{{ lock_ttl }}"
  CIRCUIT_BREAKER_FAIL_MAX: "{{ breaker_fail_max }}"
  CIRCUIT_BREAKER_TIMEOUT: "{{ breaker_timeout }}"
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: api
  namespace: {{ namespace }}
  labels: {app: api}
spec:
  replicas: {{ api_replicas }}
  selector:
    matchLabels: {app: api}
  strategy:
    type: RollingUpdate
    rollingUpdate: {maxUnavailable: 0, maxSurge: 1}
  template:
    metadata:
      labels: {app: api}
      annotations:
        prometheus.io/scrape: "true"
        prometheus.io/port: "8000"
        prometheus.io/path: /metrics
    spec:
      terminationGracePeriodSeconds: 30
      topologySpreadConstraints:
        - maxSkew: 1
          topologyKey: kubernetes.io/hostname
          whenUnsatisfiable: ScheduleAnyway
          labelSelector:
            matchLabels: {app: api}
      containers:
        - name: api
          image: {{ image }}
          imagePullPolicy: IfNotPresent
          ports:
            - containerPort: 8000
          envFrom:
            - configMapRef: {name: api-config}
          lifecycle:
            preStop:
              exec:
                command: ["sleep", "5"]
          readinessProbe:
            httpGet: {path: /health, port: 8000}
            periodSeconds: 5
          livenessProbe:
            httpGet: {path: /health, port: 8000}
            initialDelaySeconds: 10
            periodSeconds: 10
          resources:
            requests: {cpu: 100m, memory: 128Mi}
            limits: {cpu: 500m, memory: 256Mi}
---
apiVersion: v1
kind: Service
metadata:
  name: api
  namespace: {{ namespace }}
spec:
  type: NodePort
  selector: {app: api}
  ports:
    - port: 8000
      targetPort: 8000
      nodePort: {{ api_node_port }}
---
apiVersion: policy/v1
kind: PodDisruptionBudget
metadata:
  name: api
  namespace: {{ namespace }}
spec:
  minAvailable: 2
  selector:
    matchLabels: {app: api}
